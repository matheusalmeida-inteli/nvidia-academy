# ============================================================
# NVIDIA Startup AI Radar — Environment Variables
# ============================================================
# Copy to .env and fill in the values.
# Variables are read by scraper/config/settings.py (Pydantic).
# ============================================================

# ---------- PostgreSQL (structured startup data) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nvidia_radar
POSTGRES_USER=nvidia_radar
POSTGRES_PASSWORD=nvidia_radar_pass

# ---------- Qdrant (vector store for NVIDIA KB) ----------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ---------- RAG pipeline ----------
# Set to 0 to disable semantic chunking (uses parent chunks as-is)
RAG_SEMANTIC_CHUNKING=1
# Chunk target/max size (chars) and overlap — single source in rag/config.py
RAG_CHUNK_TARGET=800
RAG_CHUNK_MAX=1600
RAG_CHUNK_OVERLAP=200
# Retrieval top-k values (dense, sparse, rerank)
RAG_TOP_K_DENSE=20
RAG_TOP_K_SPARSE=20
RAG_TOP_K_RERANK=3
# Reciprocal Rank Fusion tuning
RAG_RRF_K=55
RAG_RRF_CAP=20
RAG_RRF_DENSE_WEIGHT=1.0
RAG_RRF_SPARSE_WEIGHT=1.0
# Reranking: 1=rerank, 0=skip (eval A/B)
RAG_RERANK=1
# MMR diversity wrapper (0/1) + lambda
RAG_MMR=0
RAG_MMR_LAMBDA=0.7
# Query rewrite via LLM (0/1)
RAG_QUERY_REWRITE=0
# Local dense fallback when Qdrant is down (1) or BM25-only (0)
RAG_LOCAL_DENSE_FALLBACK=1

# ---------- Cohere (embeddings + reranking) ----------
# Get free API key at https://dashboard.cohere.com/
# If blank, falls back to local TF-IDF + hash embeddings (no API cost)
COHERE_API_KEY=
# Model for text embeddings (Cohere embed-multilingual-v3.0 recommended for mixed languages)
COHERE_EMBED_MODEL=embed-multilingual-v3.0
# Model for reranking (rerank-multilingual-v3.0 for mixed languages, rerank-english-v3.0 for English-only)
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# ---------- OpenRouter (LLM calls — optional) ----------
# If blank, agents use rule-based fallbacks (no API cost, lower quality)
OPENROUTER_API_KEY=

# ---------- Scraping (optional — TAPI says out of scope) ----------
# These are used only if you run the scraper independently.
SCRAPER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36
SCRAPER_MIN_DELAY=1.0
SCRAPER_MAX_DELAY=3.0
SCRAPER_TIMEOUT=30
SCRAPER_MAX_CONCURRENCY=4
SCRAPER_RESPECT_ROBOTS=true

# ---------- Observability ----------
LOG_LEVEL=INFO
DATA_DIR=./data
